# Copy to .env and replace every placeholder before starting Compose.
# .env is ignored by Git and holds local service and test credentials.
PRODUCT_SUPERUSER_EMAIL=product-admin@katalogku.local
PRODUCT_SUPERUSER_PASSWORD=replace-with-a-long-random-password
ACCOUNT_SUPERUSER_EMAIL=account-admin@katalogku.local
ACCOUNT_SUPERUSER_PASSWORD=replace-with-a-different-long-random-password
TEST_USER_EMAIL=demo@katalogku.local
TEST_USER_PASSWORD=replace-with-a-long-test-password
TEST_USER_PASSWORD_CONFIRM=replace-with-the-same-test-password
